generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
}

enum MachineType {
  WASHER
  DRYER
  VENDING
  WATER_HEATER
  AIR_CONDITIONER
  OTHER
  PLUMBING_DEVICE
}

enum MachineStatus {
  OPERATIONAL
  OUT_OF_ORDER
  NEEDS_SERVICE
  RETIRED
}

enum UtilityType {
  ELECTRIC
  WATER
  GAS
  SEWER
}

enum RevenueSource {
  COIN
  CARD
  VENDING
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  DENIED
  RESOLVED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  // bcrypt hash of the unlock PIN. Null until the user sets one. A PIN is only
  // ever accepted alongside a registered device, never on its own.
  pinHash   String?
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes     Note[]
  incidents Incident[]
  devices   TrustedDevice[]
  documents Document[]
}

/// A browser that has completed a full password login and been enrolled for
/// PIN unlock. The raw token lives in that browser's localStorage; only its
/// hash is stored here, so a database leak cannot be replayed as a device.
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  label      String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

/// Failed-attempt counter for login throttling, keyed by "email:<address>" or
/// "ip:<address>". Rows are upserted on failure and cleared on success.
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model Machine {
  id             String        @id @default(cuid())
  name           String
  type           MachineType
  brand          String?
  model          String?
  serialNumber   String?       @unique
  location       String?
  installDate    DateTime?
  status         MachineStatus @default(OPERATIONAL)
  notes          String?
  cycleCount     Int           @default(0)
  warrantyExpiry DateTime?
  keyCode        String?
  floorZone      String?
  floorOrder     Int?
  /// This machine's reader number in FasCard, for matching FasCard
  /// transactions to this machine. Null for machines with no card reader
  /// (cash only) -- those have no FasCard data at all, by design.
  fascardMachNo  Int?          @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  maintenanceLogs      MaintenanceLog[]
  maintenanceSchedules MaintenanceSchedule[]
  revenueEntries       RevenueEntry[]
  manual               ManualDocument?
  vendingSlots         VendingSlot[]
  noteEntries          Note[]
}

model MachineModelPricing {
  id          String   @id @default(cuid())
  machineType String // "WASHER" | "DRYER"
  modelNumber String // matches Machine.model
  // Washer codes
  ats1        String? // Hot
  ats2        String? // Warm
  ats3        String? // Cold
  ats4        String? // Blankets Cold
  ats5        String? // Delicate Warm
  ats6        String? // Delicate Cold
  cnp1        String? // Extra Wash
  cnp2        String? // Extra Rinse
  // Dryer codes
  atsh        String? // Price
  cyc         String? // Cycle Time
  updatedAt   DateTime @updatedAt

  @@unique([machineType, modelNumber])
}

model MaintenanceSchedule {
  id              String    @id @default(cuid())
  title           String
  description     String?
  machineId       String?
  machine         Machine?  @relation(fields: [machineId], references: [id], onDelete: SetNull)
  machineType     String? // "WASHER" | "DRYER" | etc. — applies to all of that type
  isBuilding      Boolean   @default(false)
  frequencyDays   Int // 7=weekly 30=monthly 90=quarterly 180=semi-annual 365=annual
  lastCompletedAt DateTime?
  nextDueAt       DateTime?
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MaintenanceLog {
  id          String            @id @default(cuid())
  machineId   String?
  machine     Machine?          @relation(fields: [machineId], references: [id])
  date        DateTime
  type        String
  description String
  cost        Decimal?          @db.Decimal(10, 2)
  technician  String?
  vendor      String?
  nextDueDate DateTime?
  status      MaintenanceStatus @default(COMPLETED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  partsUsed MaintenancePartUsage[]
}

model PartInventory {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("general")
  unit         String   @default("ea")
  quantity     Int      @default(0)
  minimumStock Int      @default(1)
  costPerUnit  Decimal? @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  usages MaintenancePartUsage[]
}

model MaintenancePartUsage {
  id               String         @id @default(cuid())
  maintenanceLogId String
  maintenanceLog   MaintenanceLog @relation(fields: [maintenanceLogId], references: [id], onDelete: Cascade)
  partId           String
  part             PartInventory  @relation(fields: [partId], references: [id])
  quantityUsed     Int
  createdAt        DateTime       @default(now())
}

model RevenueEntry {
  id          String        @id @default(cuid())
  date        DateTime
  amount      Decimal       @db.Decimal(10, 2)
  source      RevenueSource @default(COIN)
  machineId   String?
  machine     Machine?      @relation(fields: [machineId], references: [id])
  // Set when a collection covers a whole class of equipment rather than one
  // machine — a coin pull from "the washers". Without this, a lump collection
  // cannot be attributed, and turns per day has nothing to divide.
  machineType MachineType?
  // True only when this lump entry is known to exclude every FasCard-mapped
  // machine of machineType -- e.g. a weighed-coin collection that
  // deliberately covers just the non-reader washers. Turns-per-day uses this
  // to count it as unmapped-machine revenue instead of ambiguous revenue;
  // a plain "coin pull from the washers" entry (source unknown whether it
  // included mapped machines) must leave this false.
  excludesFascardMachines Boolean @default(false)
  notes       String?
  collectedBy String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Cash pulled from the coin changer (bills exchanged for quarters) -- not
/// revenue, since no new money came in, but still physical cash sitting in
/// the till that needs to be deposited. Logged from the same Collect
/// Quarters round as washer/dryer coin, since it's the same visit to the
/// same machine, but kept out of RevenueEntry entirely so it can never be
/// mistaken for income.
model CoinChangerLog {
  id        String   @id @default(cuid())
  date      DateTime
  amount    Decimal  @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())
}

/// A deposit of accumulated cash on hand (vending revenue + coin changer
/// cash) to the bank. amount is what was actually taken, which can be less
/// than the full balance on hand -- the rest (a float kept back for making
/// change, say) simply isn't subtracted and stays as cash on hand; there's
/// no separate "held back" field because nothing needs to track it.
model CashDeposit {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Decimal  @db.Decimal(10, 2)
  depositedBy String?
  notes       String?
  createdAt   DateTime @default(now())
}

model UtilityBill {
  id                 String      @id @default(cuid())
  type               UtilityType
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime?
  usageAmount        Decimal     @db.Decimal(10, 3)
  usageUnit          String
  cost               Decimal     @db.Decimal(10, 2)
  provider           String?
  accountNumber      String?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model VendingProduct {
  id           String   @id @default(cuid())
  name         String
  category     String
  price        Decimal  @db.Decimal(10, 2)
  costPerUnit  Decimal? @db.Decimal(10, 2)
  currentStock Int      @default(0)
  minimumStock Int      @default(5)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales    VendingSale[]
  restocks VendingRestock[]
  slots    VendingSlot[]
}

model VendingSlot {
  id        String          @id @default(cuid())
  machineId String
  machine   Machine         @relation(fields: [machineId], references: [id], onDelete: Cascade)
  slotCode  String // e.g. "A1", "B3"
  productId String?
  product   VendingProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  capacity  Int             @default(10)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([machineId, slotCode])
}

model VendingSale {
  id        String         @id @default(cuid())
  productId String
  product   VendingProduct @relation(fields: [productId], references: [id])
  quantity  Int
  revenue   Decimal        @db.Decimal(10, 2)
  date      DateTime
  createdAt DateTime       @default(now())
}

model VendingRestock {
  id        String         @id @default(cuid())
  productId String
  product   VendingProduct @relation(fields: [productId], references: [id])
  quantity  Int
  cost      Decimal?       @db.Decimal(10, 2)
  date      DateTime
  supplier  String?
  createdAt DateTime       @default(now())
}

model BuildingMaintenance {
  id          String            @id @default(cuid())
  date        DateTime
  type        String
  description String
  cost        Decimal?          @db.Decimal(10, 2)
  vendor      String?
  nextDueDate DateTime?
  status      MaintenanceStatus @default(COMPLETED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  category    String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  vendor      String?
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Incident {
  id           String   @id @default(cuid())
  date         DateTime
  description  String
  actionTaken  String?
  followUp     String?
  resolved     Boolean  @default(false)
  reportedById String?
  reportedBy   User?    @relation(fields: [reportedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A customer-submitted request for a refund or reimbursement, usually for a
/// machine that took their money without working. Public and anonymous --
/// customers have no account -- so machineId is optional (they may not know
/// which machine, or it may no longer exist) and machineLabel is a
/// denormalized snapshot of what they picked, kept even if the Machine row
/// is later deleted or renamed. Review (status/notes) is staff-only.
///
/// Submitted from the public marketing site (clinton-laundry-works), not
/// from this app -- customers never log in here. machineLabel is a plain
/// unit number typed in by the customer (what's printed on the machine),
/// not a foreign key: the public site has no database of its own and isn't
/// meant to query this one just to populate a dropdown.
///
/// transactionAmount (what they actually fed the machine) and
/// amountRequested (what they're asking back) are both required and kept
/// separate on purpose -- they're usually equal, but someone claiming
/// consequential cost beyond the coin value needs to be able to say so, and
/// a reviewer needs to see both to judge a claim.
model RefundRequest {
  id                String              @id @default(cuid())
  machineLabel      String
  customerName      String
  customerPhone     String
  customerEmail     String?
  customerAddress   String
  issueDate         DateTime
  description       String
  transactionAmount Decimal             @db.Decimal(10, 2)
  amountRequested   Decimal             @db.Decimal(10, 2)
  // True only once the customer has checked the "I certify this is
  // accurate" box -- the API rejects the submission otherwise, so every
  // stored row has this true; it's kept as a column rather than discarded
  // so the acknowledgment itself is part of the record.
  certifiedAccurate Boolean             @default(false)
  status            RefundRequestStatus @default(PENDING)
  reviewNotes       String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  company   String?
  phone     String?
  email     String?
  role      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  content   String
  category  String   @default("general")
  isPinned  Boolean  @default(false)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  // Set when the note was written against a specific machine. Left null for
  // general shop notes, so both kinds live in one list.
  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId])
}

/// A machine or equipment manual. Several can share a machineType (a service
/// manual and a programming manual for the same washers, say). Neither
/// machineType nor machineId set means a general manual -- a card reader or
/// change machine that is not tracked as a Machine.
model ManualDocument {
  id          String   @id @default(cuid())
  name        String
  machineType String?  // WASHER/DRYER/VENDING/BUILDING — covers all of that type
  machineId   String?  @unique // specific machine — for OTHER machines with unique manuals
  machine     Machine? @relation(fields: [machineId], references: [id])
  fileName    String
  mimeType    String   @default("application/pdf")
  fileData    Bytes
  fileSize    Int
  /// NONE / INDEXING / READY / FAILED. Indexing reads the PDF with Claude and
  /// fills ManualPage and ManualEntry so the manual can be searched.
  indexStatus    String    @default("NONE")
  indexError     String?
  pageCount      Int?
  indexedPages   Int       @default(0)
  indexStartedAt DateTime?
  indexedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages   ManualPage[]
  entries ManualEntry[]

  @@index([machineType])
}

/// A short description of what one page of a manual covers. Used to pick the
/// right pages to hand Claude when answering a question.
model ManualPage {
  id         String         @id @default(cuid())
  manualId   String
  manual     ManualDocument @relation(fields: [manualId], references: [id], onDelete: Cascade)
  pageNumber Int
  summary    String

  @@unique([manualId, pageNumber])
}

/// One thing worth looking up in a manual: an error code, a programming
/// procedure, a setting, or a spec, copied from the page it appears on.
model ManualEntry {
  id        String         @id @default(cuid())
  manualId  String
  manual    ManualDocument @relation(fields: [manualId], references: [id], onDelete: Cascade)
  kind      String         // ERROR_CODE / PROCEDURE / SETTING / SPEC
  code      String?        // exactly as printed, e.g. "E:35" or "OP-CYCL"
  /// code upper-cased with everything but letters and digits removed, so
  /// "e 35", "E:35" and "E35" all match
  codeKey   String?
  title     String
  models    String?
  meaning   String?
  details   String
  pageStart Int
  pageEnd   Int

  @@index([codeKey])
  @@index([manualId])
}

/// General-purpose document storage -- leases, insurance certs, licenses,
/// policies, and anything else worth keeping on hand but not tied to a
/// specific machine the way ManualDocument is.
model Document {
  id             String   @id @default(cuid())
  name           String
  category       String   @default("general")
  fileName       String
  mimeType       String
  fileData       Bytes
  fileSize       Int
  uploadedById   String?
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// A validated but unwritten change, held between an Alfred propose call and
/// its confirmation. Stored in the database rather than in memory because
/// Railway restarts the container on deploy, and a restart mid-flow would
/// silently invalidate a token a human was about to approve.
///
/// Rows are kept after use and after expiry so a confirm attempt can say
/// precisely why it failed — already used, or expired — instead of reporting
/// an unknown token.
model AlfredProposal {
  id         String    @id @default(cuid())
  /// SHA-256 of the confirmation token. The raw token is returned once.
  tokenHash  String    @unique
  /// Which endpoint issued it. A token is only valid at the endpoint that
  /// created it, so a maintenance approval cannot be replayed as a status change.
  resource   String
  /// Resolved, validated values ready to write. Nothing is re-derived on confirm.
  payload    Json
  summary    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

/// A link to a live camera view - typically a UniFi Protect "Share Livestream"
/// link (Protect -> camera -> Settings -> Share Livestream), which is a public
/// link Ubiquiti generates specifically to be handed to someone outside the
/// Protect app, rather than the login-gated dashboard itself. The full
/// Protect dashboard URL also works fine for "Open", it just requires the
/// viewer to be signed into the Ubiquiti account that owns the console.
model Camera {
  id        String   @id @default(cuid())
  name      String
  url       String
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Civil dates remain YYYY-MM-DD strings so timezone conversion cannot move a deadline.
model ComplianceDeadline {
  workflowId String?
  workflowParentId String?
  workflowPlaceholder Boolean @default(false)
  workflowRevision Int @default(0)
  workflowOwnerName String?
  workflowAssigneeId String?
  workflowEvidenceRequirements String?
  id            String   @id @default(cuid())
  title         String
  notes         String?
  dueDate       String   @db.VarChar(10)
  deadlineType  String   @default("other")
  status        String   @default("pending")
  recurrence    String   @default("none")
  completedDate String?  @db.VarChar(10)
  parentId      String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dueDate, status])
}

model ComplianceWorkflowReceipt {
  eventId    String @id
  deadlineId String
  response   Json
  createdAt  DateTime @default(now())
}

/// Short-lived diagnostic alarms. These are deliveries, not unique visitors.
/// Exact payload retries share a hash; separate alarms may represent one crossing.
model ProtectWebhookEvent {
  id           String   @id @default(cuid())
  deliveryHash String   @unique
  alarmName    String
  reportedAt   DateTime
  receivedAt   DateTime @default(now())
  payload      Json

  @@index([receivedAt])
}

/// One laundromat line. Provider credentials stay in environment variables.
model PhoneConfig {
  id           String   @id @default("main")
  enabled      Boolean  @default(false)
  greeting     String   @default("Thank you for calling the laundromat.")
  information  String   @default("Please leave a general message for hours, location, or payment questions.")
  contacts     Json     @default("[]")
  retrySeconds Int      @default(120)
  maxAttempts  Int      @default(6)
  workerLastSeenAt DateTime?
  updatedAt    DateTime @updatedAt
}

model PhoneMessage {
  id              String    @id @default(cuid())
  callSid         String    @unique
  caller          String
  urgent          Boolean   @default(false)
  recordingSid    String?   @unique
  duration        Int?
  transcript      String?
  status          String    @default("OPEN") // OPEN / ACKNOWLEDGED / RESOLVED
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  resolvedAt      DateTime?
  resolvedBy      String?
  nextAttemptAt   DateTime?
  leaseUntil      DateTime?
  leaseToken      String?
  attemptCount    Int       @default(0)
  escalationEnded Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  attempts        PhoneAttempt[]

  @@index([urgent, status, nextAttemptAt])
}

model PhoneAttempt {
  id          String       @id @default(cuid())
  messageId   String
  message     PhoneMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sequence    Int
  contactName String
  destination String
  callSid     String?      @unique
  status      String       @default("STARTING")
  error       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([messageId, sequence])
}


// WDF financial values use integer cents; weight uses hundredths of a pound.
// Separate from machine revenue so recording a payment never counts a cycle twice.
model WdfCustomer {
  id String @id @default(cuid())
  name String
  company String?
  phone String?
  email String?
  billingAddress String?
  deliveryLocation Json?
  preferences String?
  notes String?
  customRateCents Int?
  customMinimumCents Int?
  pricingExpiresAt DateTime?
  pricingReason String?
  active Boolean @default(true)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders WdfOrder[]
  audits WdfAudit[]
  linenPlan WdfLinenPlan?
  @@index([name])
}

model WdfOrder {
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  requestKey String @unique
  requestDigest String
  customerId String
  customer WdfCustomer @relation(fields: [customerId], references: [id])
  customerName String
  customerPhone String?
  customerEmail String?
  billingAddress String?
  fulfillment String?
  serviceLocation Json?
  preferences String?
  weightHundredths Int
  rateCents Int
  minimumCents Int
  pricingSource String
  pricingReason String?
  laundryCents Int
  totalCents Int
  status String @default("RECEIVED")
  dueAt DateTime?
  notes String?
  laborMinutes Int @default(0)
  machineNotes String?
  createdById String
  createdByName String
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines WdfLine[]
  payments WdfPayment[]
  audits WdfAudit[]
  linenCharge WdfLinenCharge?
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model WdfLine {
  id String @id @default(cuid())
  orderId String
  order WdfOrder @relation(fields: [orderId], references: [id])
  description String
  quantity Int
  unitCents Int
  totalCents Int
}

model WdfPayment {
  id String @id @default(cuid())
  orderId String
  order WdfOrder @relation(fields: [orderId], references: [id])
  requestKey String @unique
  requestDigest String
  method String
  kind String @default("PAYMENT")
  amountCents Int
  reference String?
  reason String?
  recordedById String
  recordedByName String
  createdAt DateTime @default(now())
  voidedAt DateTime?
  voidedById String?
  voidReason String?
  @@index([orderId, createdAt])
}

model WdfAudit {
  id String @id @default(cuid())
  customerId String?
  customer WdfCustomer? @relation(fields: [customerId], references: [id])
  orderId String?
  order WdfOrder? @relation(fields: [orderId], references: [id])
  action String
  actorId String
  actorName String
  detail Json
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
  @@index([customerId, createdAt])
}


// One rental program per CRM customer. Quantities are custody balances:
// delivered minus returned minus write-offs, with explicit owner reconciliations.
model WdfLinenPlan {
  id String @id @default(cuid())
  customerId String @unique
  customer WdfCustomer @relation(fields: [customerId], references: [id])
  itemName String @default("Bar towels")
  towelsPerExchange Int @default(100)
  bagsPerExchange Int @default(1)
  weeklyFeeCents Int?
  exchangeDay Int? // 0=Sunday ... 6=Saturday
  towelGrams Int? // weight of one clean dry towel, calibrated to this program
  bagTareGrams Int @default(0)
  notes String?
  active Boolean @default(true)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exchanges WdfLinenExchange[]
  charges WdfLinenCharge[]
  agreements WdfServiceAgreement[]
}

model WdfLinenExchange {
  id String @id @default(cuid())
  planId String
  plan WdfLinenPlan @relation(fields: [planId], references: [id])
  requestKey String @unique
  requestDigest String
  kind String @default("EXCHANGE")
  towelsOut Int @default(0)
  towelsIn Int @default(0)
  towelsLost Int @default(0)
  bagsOut Int @default(0)
  bagsIn Int @default(0)
  bagsLost Int @default(0)
  towelAdjustment Int @default(0)
  bagAdjustment Int @default(0)
  countMethod String @default("COUNTED")
  grossGrams Int?
  towelGrams Int?
  tareGrams Int?
  notes String?
  reason String?
  actorId String
  actorName String
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([planId, occurredAt])
}

model WdfLinenCharge {
  id String @id @default(cuid())
  planId String
  plan WdfLinenPlan @relation(fields: [planId], references: [id])
  weekStart String @db.VarChar(10)
  orderId String @unique
  order WdfOrder @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
  @@unique([planId, weekStart])
}


// Immutable contract snapshots. Draft edits create a new version; issuing
// freezes the original PDF. Signed copies are held here, outside deletable Documents.
model WdfServiceAgreement {
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  planId String
  plan WdfLinenPlan @relation(fields: [planId], references: [id])
  version Int
  requestKey String @unique
  requestDigest String
  status String @default("DRAFT")
  supersedesId String?
  terms Json
  documentText String
  documentSha String
  templateVersion String @default("1")
  createdById String
  createdByName String
  createdAt DateTime @default(now())
  issuedAt DateTime?
  issuedByName String?
  issuedPdf Bytes?
  issuedPdfSha String?
  signedAt DateTime?
  signedByName String?
  providerSignedDate String? @db.VarChar(10)
  customerSignedDate String? @db.VarChar(10)
  signedFileName String?
  signedFileData Bytes?
  signedFileSha String?
  supersededAt DateTime?
  supersededById String?
  voidedAt DateTime?
  voidedByName String?
  voidReason String?
  @@unique([planId, version])
  @@index([planId, createdAt])
}
