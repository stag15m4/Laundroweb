DATABASE_URL="postgresql://user:password@localhost:5432/laundroweb"
NEXTAUTH_SECRET="your-secret-here-change-this"
NEXTAUTH_URL="http://localhost:3000"

# Legal compliance hub: separate read-only key, matching LAUNDROWEB_COMPLIANCE_TOKEN in Legal.
COMPLIANCE_SERVICE_TOKEN=

# Dedicated UniFi Protect webhook credential (at least 32 random characters).
# Send as X-Protect-Token. Never reuse an Alfred or compliance token.
PROTECT_WEBHOOK_TOKEN=

# Laundromat phone inbox (disabled until configured in Phone inbox > Setup).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Exact HTTPS origin, no trailing slash; must match Twilio's webhook URLs.
PHONE_PUBLIC_URL=
# Runs the durable escalation worker inside the long-running Node app.
PHONE_WORKER_ENABLED=false
# Optional direct on-call number if phone handling is disabled (never the public forwarded number).
PHONE_FALLBACK_NUMBER=

# Cloudflare Turnstile secret key, used to verify the public refund form on
# clintonlaundryworks.com was submitted by a human. Get it from
# https://dash.cloudflare.com/?to=/:account/turnstile (the site key, which is
# public, lives in that site's own repo, not here). Missing/unset fails
# closed -- POST /api/refund-requests rejects every submission until this is set.
TURNSTILE_SECRET_KEY=
